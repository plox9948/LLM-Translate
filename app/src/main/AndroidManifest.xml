<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        INTERNET и ACCESS_NETWORK_STATE нужны ТОЛЬКО для загрузки моделей
        по явному действию пользователя (экран «Модели»).
        Конвейер перевода работает полностью офлайн.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Видимость TTS-движков (RHVoice/eSpeak) для TextToSpeech.getInstalledEngines на Android 11+. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".OfflineTranslatorApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OfflineTranslator"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.OfflineTranslator">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Отключаем ТОЛЬКО конкретные инициализаторы androidx.startup,
            сам InitializationProvider удалять нельзя (tools:node="remove"):
            через него lifecycle-process регистрирует
            ProcessLifecycleInitializer, без него ProcessLifecycleOwner не
            attach-ится к приложению и не рассылает ON_START/ON_STOP —
            фоновая выгрузка рантаймов не планировалась.
            - WorkManagerInitializer: Application реализует
              Configuration.Provider — иначе WorkManager инициализируется
              дважды.
            - EmojiCompatInitializer: под Jetpack Compose no-op (Compose сам
              рендерит эмодзи), но через provider становился живым и тратил
              микросекунды старта. ProcessLifecycleInitializer и
              ProfileInstallerInitializer остаются живыми.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                tools:node="remove" />
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
